{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/pages/**"],
                "message": "Features must stay independent: don't import other features or pages. Compose features inside a page instead, or move shared code to src/components or src/lib."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**", "src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/pages/**"],
                "message": "Shared code must not depend on features or pages."
              }
            ]
          }
        ]
      }
    }
  ]
}
